<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DatfileCreatorStudio.ViewModels"
        xmlns:root="using:DatfileCreatorStudio"
        x:Class="DatfileCreatorStudio.Views.ZipStorePackerWindow"
        x:DataType="vm:ZipStorePackerViewModel"
        Title="ZIP Store Packer"
        Width="820" Height="740"
        MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppContentBackground}">

    <DockPanel Margin="12">

        <!-- Source -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="12,10" Margin="0,0,0,8"
                ToolTip.Tip="Wraps files in uncompressed ZIP_STORED containers — a neutral byte-preserving wrapper before downstream recompression. Each source file is verified inside its zip before the original is deleted.">
            <Grid ColumnDefinitions="150,*,Auto">
                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Target folder"/>
                <TextBox Grid.Column="1" Name="SourceBox" Text="{Binding SourcePath}" FontSize="12"
                         Watermark="Folder containing the files to wrap — drag &amp; drop works"/>
                <Button Grid.Column="2" Margin="8,0,0,0" Click="OnBrowse">
                    <PathIcon Data="{x:Static root:Icons.FolderOpen}" Width="14" Height="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- Extensions + options -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="12,10" Margin="0,0,0,8">
            <StackPanel Spacing="8">
                <TextBlock Classes="sectionHeader" Text="Target Extensions"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Name="ExtBox" Text="{Binding ExtEntry}" Width="180" FontSize="12"
                             Watermark="e.g. exe dll bin rom" KeyDown="OnExtKeyDown"/>
                    <Button Padding="12,6" Click="OnAddExt" Content="Add"/>
                    <TextBlock Classes="subtle" FontSize="11" VerticalAlignment="Center"
                               Text="space/comma separated"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Extensions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Background="{DynamicResource AppBarBackground}"
                                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="10,3" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Classes="icon" Padding="2" Click="OnRemoveExt" Tag="{Binding}"
                                            ToolTip.Tip="Remove this extension">
                                        <PathIcon Data="{x:Static root:Icons.Close}" Width="9" Height="9"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <CheckBox Classes="opt" Content="Recursive" IsChecked="{Binding Recursive}"/>
                    <CheckBox Classes="opt" Content="Verify before delete" IsChecked="{Binding Verify}"/>
                    <CheckBox Classes="opt" Content="Skip if .zip already exists" IsChecked="{Binding SkipExisting}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status + progress -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6" Spacing="3">
            <TextBlock Text="{Binding StatusText}" Classes="subtle" FontSize="11"/>
            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress}"/>
        </StackPanel>

        <!-- Buttons -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,8,0,0">
            <Button Grid.Column="0" Classes="accent" Padding="18,8" FontWeight="SemiBold"
                    Click="OnRun" IsEnabled="{Binding !IsRunning}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{x:Static root:Icons.Play}" Width="13" Height="13"/>
                    <TextBlock Text="Pack"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,8" Click="OnStop"
                    IsEnabled="{Binding IsRunning}" Content="Stop"/>
            <Button Grid.Column="2" Margin="16,0,0,0" Padding="14,8" Click="OnClearLog" Content="Clear Log"/>
            <Button Grid.Column="4" Padding="14,8" Click="OnSaveLog" Content="Save Log"/>
            <Button Grid.Column="5" Margin="8,0,0,0" Padding="14,8" Click="OnClose" Content="Close"/>
        </Grid>

        <!-- Activity log -->
        <Border Background="{DynamicResource AppLogBackground}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
            <ListBox Name="LogList" ItemsSource="{Binding Lines}" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="MinHeight" Value="18"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogLine">
                        <TextBlock Classes="logLine" Text="{Binding Text}" Foreground="{Binding Brush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
