<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DatfileCreatorStudio.ViewModels"
             xmlns:root="using:DatfileCreatorStudio"
             x:Class="DatfileCreatorStudio.Views.Controls.LogDrawer"
             x:DataType="vm:LogDrawerViewModel">

    <Border Name="DrawerRoot" Height="46"
            Background="{DynamicResource AppDrawerBackground}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,1,0,0"
            ClipToBounds="True">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Height" Duration="0:0:0.25" Easing="CubicEaseOut"/>
            </Transitions>
        </Border.Transitions>

        <DockPanel>
            <!-- Status strip (always visible) -->
            <Grid DockPanel.Dock="Top" Height="44"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="16,0,10,0">
                <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding StatusBrush}"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Elapsed}" FontSize="12"
                           Foreground="{DynamicResource AppSubtleTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ProgressBar Grid.Column="3" Width="180" Height="8" VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Maximum="{Binding ProgressMax}"
                             Value="{Binding ProgressValue}"
                             IsVisible="{Binding IsRunning}"/>
                <TextBlock Grid.Column="4" Text="{Binding ItemsText}" FontSize="12"
                           Foreground="{DynamicResource AppSubtleTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="5" Text="{Binding LastLine}" FontSize="12"
                           FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,Liberation Mono,monospace"
                           Foreground="{DynamicResource AppSubtleTextBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Button Grid.Column="6" Classes="icon" Click="OnCopyLogClick"
                        ToolTip.Tip="Copy the full log to the clipboard" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static root:Icons.ContentCopy}" Width="13" Height="13"/>
                </Button>
                <Button Grid.Column="7" Classes="icon" Command="{Binding ClearCommand}"
                        ToolTip.Tip="Clear the log" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static root:Icons.Delete}" Width="13" Height="13"/>
                </Button>
                <Button Grid.Column="8" Classes="icon" Command="{Binding ToggleExpandedCommand}"
                        ToolTip.Tip="Show or hide the activity log" VerticalAlignment="Center">
                    <Panel>
                        <PathIcon Data="{x:Static root:Icons.ChevronUp}" Width="14" Height="14"
                                  IsVisible="{Binding !IsExpanded}"/>
                        <PathIcon Data="{x:Static root:Icons.ChevronDown}" Width="14" Height="14"
                                  IsVisible="{Binding IsExpanded}"/>
                    </Panel>
                </Button>
            </Grid>

            <!-- Colour-coded activity log (revealed when expanded) -->
            <Border Background="{DynamicResource AppLogBackground}" IsVisible="{Binding IsExpanded}">
                <ListBox Name="LogList" ItemsSource="{Binding Lines}"
                         Background="Transparent" SelectionMode="Multiple"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="MinHeight" Value="18"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogLine">
                            <TextBlock Classes="logLine" Text="{Binding Text}"
                                       Foreground="{Binding Brush}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu Opening="OnLogMenuOpening">
                            <MenuItem Header="Copy Selected" Click="OnCopySelectionClick"/>
                            <MenuItem Header="Copy All" Click="OnCopyLogClick"/>
                            <Separator/>
                            <MenuItem Name="OpenInExplorerItem" Header="Open in File Explorer"
                                      Click="OnOpenInExplorerClick"
                                      ToolTip.Tip="Select a log line containing a file or folder path, then use this to open it in your file manager"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
