<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DatfileCreatorStudio.ViewModels"
        x:Class="DatfileCreatorStudio.Views.PreflightDialog"
        x:DataType="vm:PreflightDialogViewModel"
        Title="Incremental Update — Confirm Before Starting"
        Width="860" Height="640"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppContentBackground}">

    <DockPanel Margin="14">

        <!-- Title + source info -->
        <StackPanel DockPanel.Dock="Top" Spacing="2">
            <TextBlock Text="Incremental Update Pre-flight Check" FontSize="15" FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Dat source:" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DatSourceText}" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Input root:" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InputRootText}" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Dat type:" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DatTypeText}" FontSize="12"/>
            </Grid>
            <Separator Margin="0,8"/>
            <TextBlock Text="Validation Results:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
        </StackPanel>

        <!-- Bottom: version, mixed warning, buttons -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Set a new &lt;version&gt; (optional, blank = keep current):"
                           VerticalAlignment="Center" FontSize="12"/>
                <TextBox Text="{Binding NewVersion}" Width="180" FontSize="12"/>
            </StackPanel>

            <Border Background="#33E8A33D" CornerRadius="6" Padding="10,6" IsVisible="{Binding IsMixed}">
                <TextBlock FontSize="11" TextWrapping="Wrap"
                           Text="Mixed mode note: files are matched by filename and size only. If a file was replaced with new content of the same name and size, the change cannot be detected without a full rehash. Use 'Rehash entire folder' below if you know replacements of this kind have occurred."/>
            </Border>

            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                <Button Grid.Column="0" Name="ProceedButton" Classes="accent" Padding="18,8"
                        IsEnabled="{Binding CanProceed}" Click="OnProceedClick"
                        Content="Proceed" FontWeight="SemiBold"
                        ToolTip.Tip="Start the incremental update: unchanged items carry their hashes forward, new/changed items are hashed"/>
                <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,8" Click="OnFullRehashClick"
                        Content="Rehash entire folder"
                        ToolTip.Tip="Disable incremental for this run and hash everything from scratch"/>
                <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,8" Click="OnRescanClick"
                        IsEnabled="{Binding !IsScanning}" Content="Rescan Dats"
                        ToolTip.Tip="Re-run validation — useful after fixing paths or folder contents"/>
                <Button Grid.Column="3" Margin="8,0,0,0" Padding="14,8" Click="OnStopScanClick"
                        IsEnabled="{Binding CanStop}" Content="Stop Scan"/>
                <Button Grid.Column="4" Margin="8,0,0,0" Padding="14,8" Click="OnSaveLogClick"
                        IsEnabled="{Binding CanSaveLog}" Content="Save Pre-inspection Log"
                        ToolTip.Tip="Save the full timestamped report listing every missing entry and every new item"/>
                <Button Grid.Column="6" Padding="14,8" Click="OnCancelClick" Content="Cancel"/>
            </Grid>
        </StackPanel>

        <!-- Validation results -->
        <Border Background="{DynamicResource AppLogBackground}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
            <ListBox Name="ResultsList" ItemsSource="{Binding Lines}" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="MinHeight" Value="18"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogLine">
                        <TextBlock Classes="logLine" Text="{Binding Text}" Foreground="{Binding Brush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
