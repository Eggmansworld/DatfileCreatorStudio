<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DatfileCreatorStudio.ViewModels"
        xmlns:root="using:DatfileCreatorStudio"
        x:Class="DatfileCreatorStudio.Views.MergeDatfilesWindow"
        x:DataType="vm:MergeDatfilesViewModel"
        Title="Merge Datfiles"
        Width="820" Height="700"
        MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppContentBackground}">

    <DockPanel Margin="12">

        <!-- Description + root -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="12,10" Margin="0,0,0,8">
            <StackPanel Spacing="8">
                <TextBlock Classes="subtle" FontSize="11" TextWrapping="Wrap"
                           Text="Merges per-subfolder datfiles upward into a single dat placed at the first-level subfolder of a category root. Select the category root (e.g. Amiga); each first-level subfolder whose dats live in deeper subfolders is merged into one dat written into that subfolder. For dats three or more levels deep, rom names are prefixed with the intermediate folder path."/>
                <Grid ColumnDefinitions="90,*,Auto">
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Category root"/>
                    <TextBox Grid.Column="1" Name="RootBox" Text="{Binding RootPath}" FontSize="12"
                             Watermark="The category folder to scan — drag &amp; drop works"/>
                    <Button Grid.Column="2" Margin="8,0,0,0" Click="OnBrowse">
                        <PathIcon Data="{x:Static root:Icons.FolderOpen}" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,8,0,0">
            <Button Grid.Column="0" Classes="accent" Padding="18,8" FontWeight="SemiBold"
                    Click="OnRun" IsEnabled="{Binding !IsRunning}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{x:Static root:Icons.Play}" Width="13" Height="13"/>
                    <TextBlock Text="Merge"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,8" Click="OnStop"
                    IsEnabled="{Binding IsRunning}" Content="Stop"/>
            <Button Grid.Column="2" Margin="16,0,0,0" Padding="14,8" Click="OnClearLog" Content="Clear Log"/>
            <Button Grid.Column="4" Padding="14,8" Click="OnSaveLog" Content="Save Log"/>
            <Button Grid.Column="5" Margin="8,0,0,0" Padding="14,8" Click="OnClose" Content="Close"/>
        </Grid>

        <!-- Activity log -->
        <Border Background="{DynamicResource AppLogBackground}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
            <ListBox Name="LogList" ItemsSource="{Binding Lines}" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="MinHeight" Value="18"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogLine">
                        <TextBlock Classes="logLine" Text="{Binding Text}" Foreground="{Binding Brush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
