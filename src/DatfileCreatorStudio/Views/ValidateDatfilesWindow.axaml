<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DatfileCreatorStudio.ViewModels"
        xmlns:root="using:DatfileCreatorStudio"
        x:Class="DatfileCreatorStudio.Views.ValidateDatfilesWindow"
        x:DataType="vm:ValidateDatfilesViewModel"
        Title="Validate Datfiles"
        Width="940" Height="700"
        MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppContentBackground}">

    <DockPanel Margin="12">

        <!-- Source -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="12,10" Margin="0,0,0,10"
                ToolTip.Tip="Validates every &lt;rom&gt; entry: size must be a decimal number, crc 8 hex chars, sha1 40 hex chars (all required); md5/sha256/blake3 are validated when present.">
            <Grid ColumnDefinitions="150,*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Dat file or folder"/>
                <TextBox Grid.Column="1" Name="TargetBox" Text="{Binding TargetPath}" FontSize="12"
                         Watermark="A single dat validates alone; a folder is searched recursively — drag &amp; drop works"/>
                <Button Grid.Column="2" Margin="8,0,0,0" Click="OnBrowseFile"
                        ToolTip.Tip="Browse for a single dat file">
                    <PathIcon Data="{x:Static root:Icons.FileDocument}" Width="14" Height="14"/>
                </Button>
                <Button Grid.Column="3" Margin="4,0,0,0" Click="OnBrowseFolder"
                        ToolTip.Tip="Browse for a folder of dats">
                    <PathIcon Data="{x:Static root:Icons.FolderOpen}" Width="14" Height="14"/>
                </Button>
                <Button Grid.Column="4" Classes="accent" Margin="10,0,0,0" Padding="16,7"
                        FontWeight="SemiBold" Click="OnRun" IsEnabled="{Binding !IsRunning}"
                        Content="Validate"/>
                <Button Grid.Column="5" Margin="6,0,0,0" Padding="12,7" Click="OnStop"
                        IsEnabled="{Binding IsRunning}" Content="Stop"/>
            </Grid>
        </Border>

        <!-- Bottom bar -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,10,0,0">
            <Button Grid.Column="0" Padding="14,8" Click="OnClearLog" Content="Clear Log"/>
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,8" Click="OnSaveLog" Content="Save Log"/>
            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="subtle" FontSize="12"
                       VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="3" Padding="14,8" Click="OnClose" Content="Close"/>
        </Grid>

        <!-- Results log -->
        <Border Background="{DynamicResource AppLogBackground}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
            <ListBox Name="LogList" ItemsSource="{Binding Lines}" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="MinHeight" Value="18"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogLine">
                        <TextBlock Classes="logLine" Text="{Binding Text}" Foreground="{Binding Brush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
